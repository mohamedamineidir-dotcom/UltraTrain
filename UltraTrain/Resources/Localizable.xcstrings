      }
    },
    "prc.msg" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your B-race %1$@ (%2$@, ~%3$@ effective km) is more demanding than your A-race %4$@ (~%5$@ effective km), and falls only ~%6$lld weeks before. Recovery from an effort that size realistically takes 4-6 weeks, your A-race goal will likely be affected. Consider whether to swap A/B priority, set a more conservative A-race goal, or push the A-race further out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre course B %1$@ (%2$@, ~%3$@ km effectifs) est plus exigeante que votre course A %4$@ (~%5$@ km effectifs), et tombe seulement ~%6$lld semaines avant. La récupération d'un effort de cette taille prend réellement 4-6 semaines ; votre objectif de course A en sera probablement affecté. Envisagez d'inverser la priorité A/B, de fixer un objectif de course A plus prudent, ou de repousser la course A."
          }
        }
      }
    },
    "prc.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "B-race may compromise A-race goal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La course B pourrait compromettre l'objectif de la course A"
          }
        }
      }
    },
