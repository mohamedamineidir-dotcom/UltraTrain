      }
    },
    "Adding any B or C races now lets the plan shape its build, taper and recovery around them." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter des courses B ou C maintenant permet au plan d'organiser sa montée en charge, son affûtage et sa récupération autour d'elles."
          }
        }
      }
    },
    "Additional notes" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes supplémentaires"
          }
        }
      }
    },
    "Adds 1 to 3 race-pace quality sessions in the 2 to 3 weeks before this race. VO2max for 10K, threshold for HM, MP blocks for marathon. Replaces existing intervals, no extra fatigue." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute 1 à 3 séances de qualité à allure de course dans les 2 à 3 semaines avant cette course. VO2max pour le 10 km, seuil pour le semi, blocs à allure marathon pour le marathon. Remplace les fractionnés existants, sans fatigue supplémentaire."
          }
        }
      }
    },
