    "trrt.cross" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cross-training %lld min, easy bike, swim, or elliptical. Concentric only, no eccentric loading. Promotes blood flow without re-damaging quads."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cross-training %lld min : vélo, natation ou elliptique en facile. Concentrique uniquement, pas de charge excentrique. Favorise la circulation sans réendommager les quadriceps."
          }
        }
      }
    },
    "trrt.walk" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walking %lld min, easy. Light movement, no impact. If you have stairs at home, take them, gentle eccentric reload helps quads remap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marche %lld min, facile. Mouvement léger, sans impact. Si vous avez des escaliers chez vous, prenez-les : une légère recharge excentrique aide les quadriceps à se réadapter."
          }
        }
      }
    },
