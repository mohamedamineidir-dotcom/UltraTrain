    "vga.010" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy warm-up, include 4-6 strides"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échauffement facile, inclure 4-6 lignes droites"
