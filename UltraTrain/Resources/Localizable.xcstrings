    },
    "sk.012" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatigue noted. A single rest is often all you need, no plan changes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatigue notée. Un seul jour de repos suffit souvent, aucun changement au plan."
          }
        }
      }
    },
    "sk.013" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatigue noted. As a newer runner, listen to your body, you can ease the next hard session if needed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatigue notée. En tant que coureur débutant, écoutez votre corps : vous pouvez alléger la prochaine séance dure si besoin."
          }
        }
      }
    },
    "sk.014" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequent time-based skips. The plan might not match your schedule, consider adjusting your preferred runs per week."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séances souvent manquées par manque de temps. Le plan ne correspond peut-être pas à votre emploi du temps : envisagez d'ajuster votre nombre de séances par semaine."
          }
        }
      }
    },
    "sk.015" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard training suppresses immunity. Remaining hard sessions this week converted to easy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement intense affaiblit l'immunité. Les séances dures restantes de la semaine sont converties en facile."
          }
        }
      }
    },
    "sk.016" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If an athlete misses for non-physiological reasons, the best response is nothing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un athlète manque une séance pour des raisons non physiologiques, la meilleure réponse est de ne rien faire."
          }
        }
      }
    },
    "sk.017" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illness noted. Remaining hard sessions eased off. Light reduction next week to support recovery."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maladie notée. Séances dures restantes allégées. Légère réduction la semaine prochaine pour soutenir la récupération."
          }
        }
      }
    },
    "sk.018" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injury reported. All remaining sessions cancelled. Next week significantly reduced. Do NOT run through pain, cross-train if possible. See a professional if pain persists beyond 48-72h."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blessure signalée. Toutes les séances restantes sont annulées. Semaine prochaine fortement réduite. Ne courez PAS sur la douleur, faites du cross-training si possible. Consultez un professionnel si la douleur persiste au-delà de 48-72h."
          }
        }
      }
    },
    "sk.019" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lighter next week"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semaine prochaine allégée"
          }
        }
      }
    },
    "sk.020" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lighter week after illness"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semaine allégée après la maladie"
          }
        }
      }
    },
    "sk.021" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logged as menstrual-cycle skip. Symptom-specific options will surface separately if you flagged bleed-day or PMS symptoms."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré comme séance manquée liée au cycle menstruel. Des options spécifiques aux symptômes apparaîtront séparément si vous avez signalé des symptômes de règles ou de SPM."
          }
        }
      }
    },
    "sk.022" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiple illness skips logged in the last 2 weeks. Two-week stair-step reduction in place, return to full load only when symptom-free 48h+. Persistent illness > 10 days warrants a doctor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs séances manquées pour maladie ces 2 dernières semaines. Réduction par paliers sur deux semaines en place ; reprise de la charge complète seulement après 48h+ sans symptômes. Une maladie persistante > 10 jours justifie une consultation médicale."
          }
        }
      }
    },
    "sk.023" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multiple injury skips logged in the last 2 weeks. Two-week stair-step rebuild in place, return to running only when pain-free, and if pain returns or persists, see a sports-med professional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs séances manquées pour blessure ces 2 dernières semaines. Reprise par paliers sur deux semaines en place ; retour à la course seulement sans douleur, et si la douleur revient ou persiste, consultez un médecin du sport."
          }
        }
      }
    },
