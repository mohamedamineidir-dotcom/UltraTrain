    "stg.001" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build phase: increase weight or difficulty. Add power movements. Quality over quantity, stop if form breaks down. Allow 4-6 hours between running and this session."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phase de développement : augmentez la charge ou la difficulté. Ajoutez des mouvements de puissance. La qualité prime sur la quantité, arrêtez si la technique se dégrade. Laissez 4-6 heures entre la course et cette séance."
          }
        }
      }
    },
