      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "at the target intensity, then finishes with %lld minutes on your hill. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "à l'intensité cible, puis se termine par %lld minutes sur votre côte. "
          }
        }
      }
    },
    "vga.flatSubst" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat power intervals (VG substitute). Same intensity, same duration. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalles de puissance sur plat (substitut D+). Même intensité, même durée. %@"
          }
        }
      }
    },
    "vga.flatThenHill" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldmin flat at target intensity, then %2$@ uphill. Time your run to arrive at the hill for the final portion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldmin sur plat à l'intensité cible, puis %2$@ en montée. Calez votre sortie pour arriver à la côte sur la portion finale."
          }
        }
      }
    },
    "vga.flatThreshold" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flat portion should be at your threshold effort. By the time you hit the hill, your legs should feel like you have been climbing for %lld minutes already."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La portion plate doit être à votre effort de seuil. Au moment d'attaquer la côte, vos jambes doivent avoir la sensation d'avoir déjà grimpé pendant %lld minutes."
          }
        }
      }
    },
    "vga.hillShorter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your hill is shorter than the ideal rep length, so each rep starts with %lld minutes of flat running "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre côte est plus courte que la longueur idéale de répétition, donc chaque répétition commence par %lld minutes de course sur plat "
          }
        }
      }
    },
    "vga.repStructure" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldx(%2$lldmin flat + %3$lldmin uphill) at target intensity / jog back"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldx(%2$lldmin plat + %3$lldmin côte) à l'intensité cible / footing de retour"
          }
        }
      }
    },
    "vga.treadmillControl" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treadmill gives you full control over incline and duration. %@ "
          }
        },
        "fr" : {
          "stringUnit" : {
