    "stg.044" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peak maintenance: keep loads moderate, reduce volume. You're preserving strength, not building it. 2-3 sets max per exercise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintien en phase de pic : gardez des charges modérées, réduisez le volume. Vous préservez la force, vous ne la construisez plus. 2-3 séries max par exercice."
          }
        }
      }
    },
