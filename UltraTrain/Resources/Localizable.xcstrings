    "wtl.001" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical Descent Focus"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travail de descente technique"
          }
        }
      }
    },
    "wtl.002" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus on downhill technique on technical single-track. Practice foot placement, quick cadence, and staying relaxed on steep descents."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaillez la technique de descente sur single-track technique. Travaillez le placement des appuis, une cadence rapide et le relâchement dans les descentes raides."
          }
        }
      }
    },
    "wtl.003" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night Trail Run"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortie trail de nuit"
          }
        }
      }
    },
    "wtl.004" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice running with a headlamp on familiar trails. Build confidence for night sections during ultra races."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-vous à courir avec une frontale sur des sentiers familiers. Gagnez en confiance pour les sections de nuit en ultra."
          }
        }
      }
    },
    "wtl.005" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single-Track Agility"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agilité en single-track"
          }
        }
      }
    },
    "wtl.006" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short bursts on technical terrain with frequent direction changes. Improves proprioception and trail agility."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointes courtes sur terrain technique avec changements de direction fréquents. Améliore la proprioception et l'agilité en trail."
          }
        }
      }
    },
    "wtl.007" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trail Fartlek"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fartlek trail"
          }
        }
      }
    },
    "wtl.008" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unstructured speed play: alternate fast and easy efforts using terrain as cues. Surge on climbs, recover on flats."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeu d'allure libre : alternez efforts rapides et faciles en vous servant du terrain. Accélérez dans les montées, récupérez sur le plat."
          }
        }
      }
    },
    "wtl.009" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lactate Threshold Run"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance au seuil lactique"
          }
        }
      }
    },
    "wtl.010" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustained effort at comfortably hard pace (Zone 4). Build the ability to run faster for longer at threshold intensity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort soutenu à allure confortablement dure (Zone 4). Développez la capacité à courir plus vite plus longtemps à l'intensité du seuil."
          }
        }
      }
    },
    "wtl.011" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track Intervals"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalles sur piste"
          }
        }
      }
    },
    "wtl.012" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6-8 x 3-minute hard efforts with 2-minute recovery jog. Classic VO2max builder on flat terrain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6-8 × 3 minutes d'efforts intenses avec 2 minutes de footing de récupération. Classique pour développer la VO2max sur terrain plat."
          }
        }
      }
    },
    "wtl.013" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progressive Tempo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo progressif"
          }
        }
      }
    },
    "wtl.014" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start easy and gradually increase pace every 3 km until finishing at tempo effort. Teaches pacing discipline."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partez facile et augmentez l'allure progressivement tous les 3 km pour finir à effort tempo. Apprend la discipline d'allure."
          }
        }
      }
    },
    "wtl.015" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hill Repeats"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétitions en côte"
          }
        }
      }
    },
    "wtl.016" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8-10 x 3-minute uphill hard efforts with jog-down recovery. Build climbing power and muscular endurance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8-10 × 3 minutes d'efforts intenses en montée avec descente en footing pour récupérer. Développe la puissance en côte et l'endurance musculaire."
          }
        }
      }
    },
    "wtl.017" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power Hiking Session"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance de marche active"
          }
        }
      }
    },
    "wtl.018" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustained steep uphill hiking with poles. Practice race-specific power hiking technique at 600-900 m/hr vertical speed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marche active soutenue en forte pente avec bâtons. Travaillez la technique de marche active spécifique à la course à 600-900 m/h de vitesse ascensionnelle."
          }
        }
      }
    },
    "wtl.019" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staircase Session"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance d'escaliers"
          }
        }
      }
    },
    "wtl.020" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stair climbing repeats for vertical gain. 10 x 50m D+ with walk-down recovery. Great for building leg strength."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répétitions de montée d'escaliers pour le dénivelé. 10 × 50m D+ avec descente en marche pour récupérer. Excellent pour renforcer les jambes."
          }
        }
      }
    },
    "wtl.021" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery Shakeout"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Footing de déblocage"
          }
        }
      }
    },
    "wtl.022" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very easy, short run to promote blood flow and recovery. Stay in Zone 1-2, conversational pace only."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortie courte et très facile pour favoriser la circulation et la récupération. Restez en Zone 1-2, allure d'aisance uniquement."
          }
        }
      }
    },
    "wtl.023" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active Recovery"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération active"
          }
        }
      }
    },
    "wtl.024" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light cross-training: swimming, cycling, or yoga. Keep effort very easy to aid recovery without adding run stress."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cross-training léger : natation, vélo ou yoga. Gardez un effort très facile pour aider la récupération sans ajouter de stress de course."
          }
        }
      }
    },
    "wtl.025" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trail Walk"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marche en trail"
          }
        }
      }
    },
    "wtl.026" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy hike on trails with light elevation. Active recovery that keeps you moving without running impact."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randonnée facile sur sentiers avec un léger dénivelé. Récupération active qui vous garde en mouvement sans l'impact de la course."
          }
        }
      }
    },
    "wtl.027" : {
      "localizations" : {
        "en" : {
