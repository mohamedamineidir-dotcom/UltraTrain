    "stg.030" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foundation phase: focus on learning proper form with moderate loads. Build the strength base that will support harder training later. Take 60-90 sec rest between sets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phase de fondation : concentrez-vous sur l'apprentissage de la bonne technique avec des charges modérées. Construisez la base de force qui soutiendra un entraînement plus dur ensuite. Prenez 60-90 s de récup entre les séries."
          }
        }
      }
    },
    "stg.031" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle activation to promote blood flow and recovery. Stop immediately if anything feels off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activation douce pour favoriser la circulation et la récupération. Arrêtez immédiatement si quelque chose cloche."
          }
        }
      }
    },
    "stg.032" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervals at moderate effort. Maintain sharpness."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fractionné à effort modéré. Conservez la vivacité."
          }
        }
      }
    },
    "stg.033" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervals at normal intensity, slightly reduced volume. Stay sharp."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fractionné à intensité normale, volume légèrement réduit. Restez vif."
          }
        }
      }
    },
    "stg.034" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it controlled and focused. Listen to your body."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez contrôlé et concentré. Écoutez votre corps."
          }
        }
      }
    },
    "stg.035" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light activation only. No soreness allowed, your race is close. These movements keep muscles firing without creating fatigue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activation légère uniquement. Pas de courbatures, votre course approche. Ces mouvements gardent les muscles actifs sans créer de fatigue."
          }
        }
      }
    },
    "stg.036" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light activation routine. Wake up the stabilizers before your next run."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routine d'activation légère. Réveillez les stabilisateurs avant votre prochaine sortie."
          }
        }
      }
    },
    "stg.037" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long run at reduced volume. Save energy for race week."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortie longue à volume réduit. Gardez de l'énergie pour la semaine de course."
          }
        }
      }
    },
    "stg.038" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderate intervals. Reintroduce leg speed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fractionné modéré. Réintroduisez la vitesse de jambes."
          }
        }
      }
    },
    "stg.039" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderate intervals. Reintroduce quality, don't force it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fractionné modéré. Réintroduisez la qualité, sans forcer."
          }
        }
      }
    },
    "stg.040" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderate tempo. Rebuild threshold feel without overloading fresh-from-race legs."
