    },
    "road.coach.rest" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest is where adaptation happens. Trust the process."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est au repos que se produit l'adaptation. Faites confiance au processus."
          }
        }
      }
    },
    "road.coach.shortPrep.half" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compressed prep alert: HM prep benefits from at least 8 weeks for meaningful threshold development. Your plan is running shorter. Consider a conservative finish goal, and trust your aerobic base rather than chasing speed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerte préparation compressée : une prépa semi profite d'au moins 8 semaines pour un vrai développement du seuil. Votre plan est plus court. Envisagez un objectif d'arrivée prudent et fiez-vous à votre base aérobie plutôt que de courir après la vitesse."
          }
        }
      }
    },
    "road.coach.shortPrep.marathon" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compressed prep alert: marathon builds typically run 16-18 weeks, with 8 weeks of aerobic base development alone. Your base is truncated, which caps how much aerobic engine you can build before race day. Strongly recommend a conservative finish goal (add 5-10% to your target) or deferring to a later race if the calendar allows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerte préparation compressée : un cycle marathon dure généralement 16-18 semaines, dont 8 semaines de développement de la base aérobie. Votre base est tronquée, ce qui limite le moteur aérobie que vous pouvez construire avant le jour J. Nous recommandons fortement un objectif d'arrivée prudent (ajoutez 5-10 % à votre cible) ou de reporter à une course ultérieure si le calendrier le permet."
          }
        }
      }
    },
    "road.coach.shortPrep.tenK" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compressed prep alert: 10K plans normally run 6+ weeks. Your base is short. Prioritize finishing cleanly over hitting a hard target."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerte préparation compressée : un plan 10 km dure normalement 6 semaines ou plus. Votre base est courte. Privilégiez une arrivée propre plutôt qu'un objectif difficile."
          }
        }
      }
    },
