    "pr.section.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your records are the times you've actually run. Current fitness projects equivalents across every distance from your best recent result, and updates as you train or log a faster PR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos records sont les temps que vous avez réellement réalisés. La forme actuelle projette des équivalents sur chaque distance à partir de votre meilleur résultat récent, et évolue à mesure que vous vous entraînez ou enregistrez un record plus rapide."
          }
        }
      }
    },
