      }
    },
    "sk.002" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust for adherence"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster selon l'assiduité"
          }
        }
      }
    },
    "sk.003" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All remaining sessions this week should be rest or gentle cross-training (swimming, cycling). Do not run through an injury."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les séances restantes de la semaine devraient être du repos ou du cross-training doux (natation, vélo). Ne courez pas sur une blessure."
          }
        }
      }
    },
    "sk.004" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel remaining"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler les séances restantes"
          }
        }
      }
    },
    "sk.005" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consider easing next hard session"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envisagez d'alléger la prochaine séance dure"
          }
        }
      }
    },
    "sk.006" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert to easy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertir en facile"
          }
        }
      }
    },
    "sk.007" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't try to make up missed sessions. A single miss is meaningless."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'essayez pas de rattraper les séances manquées. Une seule séance manquée n'a aucune importance."
          }
        }
      }
    },
    "sk.008" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ease next hard session"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allégez la prochaine séance dure"
          }
        }
      }
    },
    "sk.009" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ease off while unwell"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez le pied tant que vous êtes souffrant"
          }
        }
      }
    },
    "sk.010" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ease off, fatigue pattern detected"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez le pied, schéma de fatigue détecté"
          }
