    "trt.raceDay" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RACE: %1$@ (%2$@%3$@). The journey ends here. Trust your training, fuel like clockwork, manage the climbs, respect the descents. The first half is for patience, the second half is for grit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "COURSE : %1$@ (%2$@%3$@). Le voyage se termine ici. Faites confiance à votre entraînement, alimentez-vous comme une horloge, gérez les montées, respectez les descentes. La première moitié est pour la patience, la seconde pour le cran."
          }
        }
      }
