    "sxa.carb" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note for female athletes: research (Sims 2016) suggests higher carb demand on long efforts, especially through the luteal phase. Fuel generously, 30-60 g carbs per hour, starting before you feel you need it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note pour les athlètes féminines : la recherche (Sims 2016) suggère un besoin accru en glucides sur les longs efforts, surtout pendant la phase lutéale. Alimentez-vous généreusement, 30-60 g de glucides par heure, en commençant avant d'en ressentir le besoin."
          }
        }
      }
    },
    "sxa.descentACL" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note for female athletes: descent-running carries higher ACL/knee load for women due to Q-angle and quad-hamstring ratio (Stachenfeld). Keep descents controlled, strong cadence, soft landings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note pour les athlètes féminines : la course en descente sollicite davantage le LCA et le genou chez les femmes en raison de l'angle Q et du ratio quadriceps-ischio-jambiers (Stachenfeld). Gardez des descentes contrôlées, une cadence soutenue, des réceptions souples."
          }
        }
      }
    },
    "sxa.iron" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note for female athletes: high-intensity blocks raise iron turnover. If you're trending tired beyond what training explains, a ferritin check is worth it. Target 15-18 mg/day through diet or supplementation (Sims 2016)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note pour les athlètes féminines : les blocs à haute intensité augmentent le renouvellement du fer. Si vous vous sentez fatiguée au-delà de ce que l'entraînement explique, un dosage de ferritine vaut le coup. Visez 15-18 mg/jour via l'alimentation ou la supplémentation (Sims 2016)."
          }
        }
      }
    },
    "sxa.redS" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note for female athletes: through heavy training weeks, watch energy availability. Under-fuelling risks bone health and hormonal balance (RED-S, Mountjoy 2014). Eat to support the load, not to control weight."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note pour les athlètes féminines : pendant les semaines de charge, surveillez votre disponibilité énergétique. Un sous-apport menace la santé osseuse et l'équilibre hormonal (RED-S, Mountjoy 2014). Mangez pour soutenir la charge, pas pour contrôler votre poids."
          }
        }
      }
    },
