      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a recovery day immediately. When resuming, vary session types and reduce volume by 20-30%."
          }
        },
        "fr" : {
          "stringUnit" : {
