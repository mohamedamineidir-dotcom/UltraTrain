    "mac.msg" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've logged %lld cycle-related skips in the last week. Your body's already dialled the load, let this week be a soft deload (easy + recovery only, no key quality), then resume normal training next week. McNulty 2020: when symptoms drive availability, listen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez enregistré %lld séances manquées liées au cycle cette dernière semaine. Votre corps a déjà ajusté la charge ; faites de cette semaine un léger allègement (facile + récupération uniquement, aucune qualité clé), puis reprenez l'entraînement normal la semaine prochaine. McNulty 2020 : quand les symptômes dictent la disponibilité, écoutez."
          }
        }
      }
    },
