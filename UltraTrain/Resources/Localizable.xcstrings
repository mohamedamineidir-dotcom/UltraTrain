    "ntx.caffeine.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 to 6 mg per kg of body weight, tuned to your tolerance. Spread across the race, with night doses for ultras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 à 6 mg par kg de poids corporel, ajusté à votre tolérance. Réparti sur la course, avec des doses nocturnes pour les ultras."
          }
        }
      }
    },
    "ntx.caffeine.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caffeine"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caféine"
          }
        }
      }
    },
    "ntx.carbs.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaled to your race duration. Most runners need 60 to 90 g per hour, from a mix of glucose and fructose to avoid GI issues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapté à la durée de votre course. La plupart des coureurs ont besoin de 60 à 90 g par heure, à partir d'un mélange de glucose et de fructose pour éviter les troubles digestifs."
          }
        }
      }
    },
    "ntx.carbs.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carbs per hour"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glucides par heure"
          }
        }
      }
    },
    "ntx.hydration.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set from your sweat rate, or estimated from your weight and the weather. We aim to replace about 80% of what you lose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défini d'après votre taux de transpiration, ou estimé d'après votre poids et la météo. Nous visons à remplacer environ 80% de ce que vous perdez."
          }
        }
      }
    },
    "ntx.hydration.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydration"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydratation"
          }
        }
      }
    },
    "ntx.sodium.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matched to how salty your sweat is. Races over 6 hours apply a 575 mg per liter floor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusté à la salinité de votre sueur. Les courses de plus de 6 heures appliquent un plancher de 575 mg par litre."
          }
        }
      }
    },
    "ntx.sodium.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodium"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodium"
          }
        }
      }
    },
    "ntx.why.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your gut can be trained. Start at 40 g per hour, add 10 g every two weeks, and test your full race intake on two long runs before the event."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre système digestif s'entraîne. Commencez à 40 g par heure, ajoutez 10 g toutes les deux semaines, et testez votre apport complet de course sur deux sorties longues avant l'épreuve."
          }
        }
      }
    },
    "ntx.why.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why practice this in training?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi s'entraîner à ceci ?"
          }
        }
      }
    },
