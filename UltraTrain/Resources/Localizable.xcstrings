        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marques de sel blanches sur les t-shirts foncés, yeux qui piquent, cristaux sur la peau"
          }
        }
      }
    },
    "Why are you skipping this session?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi sautez-vous cette séance ?"
          }
        }
      }
    },
    "Why these targets" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi ces cibles"
          }
        }
      }
    },
    "Why?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi ?"
          }
        }
      }
    },
    "why.body.b2b" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two long days stacked trains your legs to run tired. Core ultra-specific stimulus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux longues journées enchaînées entraînent vos jambes à courir fatiguées. Stimulus central spécifique à l'ultra."
          }
        }
      }
    },
    "why.body.intervals" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short fast reps push your VO2max ceiling. The recovery between reps is part of the work."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des répétitions courtes et rapides repoussent votre plafond de VO2max. La récupération entre les répétitions fait partie du travail."
          }
        }
      }
    },
    "why.body.longRun" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time on feet builds the aerobic base everything else sits on. Easy and long wins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps passé debout construit la base aérobie sur laquelle tout repose. Facile et long, c'est gagnant."
          }
        }
      }
    },
    "why.body.race" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute the plan. Trust the training."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déroulez le plan. Faites confiance à l'entraînement."
          }
        }
      }
    },
    "why.body.recovery" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptation happens when you recover, not when you train. Keep it genuinely easy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adaptation se produit pendant la récupération, pas pendant l'entraînement. Restez vraiment facile."
          }
        }
      }
    },
    "why.body.strength" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the chassis strong through heavy weeks. Fewer injuries, better economy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le châssis solide pendant les semaines chargées. Moins de blessures, meilleure économie."
          }
        }
      }
    },
    "why.body.tempo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is race-pace sustainability work. Comfortably hard, not all-out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est du travail de tenue à allure de course. Confortablement dur, pas à fond."
          }
        }
      }
    },
    "why.body.today" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every session has a purpose. Stay consistent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque séance a un but. Restez régulier."
          }
        }
      }
    },
    "why.body.vertical" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Climbing-specific strength. Power-hike the steep stuff; that's the specificity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force spécifique à la grimpe. Marchez activement les passages raides ; c'est ça la spécificité."
          }
        }
      }
    },
    "why.title.b2b" : {
      "localizations" : {
