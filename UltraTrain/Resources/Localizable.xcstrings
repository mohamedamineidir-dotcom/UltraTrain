    "road.coach.easy.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it truly easy, at conversational pace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez vraiment facile, à allure de conversation."
          }
        }
      }
    },
    "road.coach.easy.outro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is where your aerobic engine grows. Resist the urge to push."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est ici que votre moteur aérobie se développe. Résistez à l'envie de forcer."
          }
        }
      }
    },
    "road.coach.firstTimer.half" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First-timer note: keep the first 15 km conservative. A common first-half-marathon mistake is starting at 10K effort and blowing up at 17 km. Save a little for the final 5 km."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note débutant : restez prudent sur les 15 premiers kilomètres. Une erreur fréquente au premier semi est de partir à l'effort du 10 km et d'exploser au 17e km. Gardez-en un peu pour les 5 derniers kilomètres."
          }
        }
      }
    },
    "road.coach.firstTimer.marathon" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First-timer note: prioritize finishing strong over hitting a specific time. First-time marathoners most often blow up in the final 10K from going out too hard. Hold marathon pace even when it feels too easy in the first half. The fast target belongs to race #2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note débutant : privilégiez une arrivée solide plutôt qu'un temps précis. Les marathoniens débutants explosent le plus souvent dans les 10 derniers kilomètres pour être partis trop vite. Tenez l'allure marathon même si elle semble trop facile en première moitié. Le temps rapide, ce sera pour le marathon n°2."
          }
        }
      }
    },
    "road.coach.firstTimer.tenK" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First-timer note: most first 10Ks go out too hard. Settle into goal pace by 2 km and save a surge for the final 2 km, not the first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note débutant : la plupart des premiers 10 km partent trop vite. Installez-vous à l'allure objectif dès le 2e km et gardez une accélération pour les 2 derniers, pas les premiers."
          }
        }
      }
    },
    "road.coach.goal.ambitious" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: goal is ambitious. Training paces reflect current fitness; race-specific work unlocks in late peak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : objectif ambitieux. Les allures d'entraînement reflètent votre forme actuelle ; le travail spécifique course se débloque en fin de pic."
          }
        }
      }
    },
    "road.coach.goal.veryAmbitious" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠ Goal is very ambitious vs current fitness. Race pace unlocks only if your tune-up trial confirms it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠ Objectif très ambitieux par rapport à votre forme actuelle. L'allure de course ne se débloque que si votre test de validation le confirme."
          }
        }
      }
    },
    "road.coach.goal.veryAmbitious.withTarget" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠ Goal is very ambitious. A realistic target right now is ~%@. Race pace unlocks only if your tune-up trial confirms it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠ Objectif très ambitieux. Une cible réaliste actuellement est ~%@. L'allure de course ne se débloque que si votre test de validation le confirme."
          }
        }
      }
    },
    "road.coach.hotRace" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot-race advisory: forecast suggests warm/humid race conditions. Practical acclimation: (1) sauna sessions 20-30 min at 60-80 °C, 3× per week starting 2 weeks out (passive heat exposure yields ~50-70% of active-heat benefit); (2) overdress on easy runs during the final 10 days; (3) pre-cool with ice slurry or cold water 15 min before the race; (4) expect to pace 10-30 s/km slower than your cool-weather goal pace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerte course par temps chaud : les prévisions annoncent des conditions chaudes/humides. Acclimatation pratique : (1) séances de sauna de 20-30 min à 60-80 °C, 3× par semaine à partir de 2 semaines avant (l'exposition passive à la chaleur apporte ~50-70 % du bénéfice de la chaleur active) ; (2) habillez-vous chaudement sur les footings faciles les 10 derniers jours ; (3) pré-refroidissez avec une boisson glacée ou de l'eau froide 15 min avant la course ; (4) attendez-vous à courir 10-30 s/km plus lentement que votre allure objectif par temps frais."
          }
        }
      }
    },
    "road.coach.interval.base" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed strides and short reps. Focus on form and leg turnover, not raw speed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lignes droites et répétitions courtes. Concentrez-vous sur la technique et la fréquence de jambes, pas la vitesse pure."
          }
        }
      }
    },
    "road.coach.interval.build" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max session. Run the intervals at a controlled hard effort, working hard but not sprinting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance VO2max. Courez les fractions à un effort dur mais contrôlé, intense sans sprinter."
          }
        }
      }
    },
