    "msb.body.inactivity" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's been %lld days since your last completed session. The plan's later blocks assume fitness built in between. Rebalancing re-anchors the paces and load targets to what you've actually done."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela fait %lld jours depuis votre dernière séance terminée. Les blocs suivants du plan supposent une forme construite entretemps. Le rééquilibrage réancre les allures et les objectifs de charge sur ce que vous avez réellement fait."
          }
        }
      }
    },
    "msb.body.multiSkip" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've skipped %lld sessions in the last 14 days. The plan keeps prescribing work based on the original schedule, a rebalance pulls everything into line with your current trajectory."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez manqué %lld séances ces 14 derniers jours. Le plan continue de prescrire du travail selon le planning d'origine ; un rééquilibrage aligne tout sur votre trajectoire actuelle."
          }
        }
      }
    },
    "msb.body.qualityDrift" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld quality sessions have been skipped or under-executed. Quality is what builds the specific adaptations the later blocks assume, without it, race-pace targets may be ambitious."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld séances de qualité ont été manquées ou sous-exécutées. La qualité construit les adaptations spécifiques que supposent les blocs suivants ; sans elle, les objectifs d'allure de course peuvent être ambitieux."
          }
        }
      }
    },
