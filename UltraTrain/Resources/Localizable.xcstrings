    "sk.001" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A couple motivation dips noted. No changes yet, reach out if it persists."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques baisses de motivation notées. Aucun changement pour l'instant, signalez-le si cela persiste."
          }
