    "coach.backToBack" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Today you run on yesterday's fatigue. This is ultra-specific. Start easy and stay patient."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aujourd'hui vous courez sur la fatigue d'hier. C'est spécifique ultra. Démarrez doucement."
          }
        }
      }
    },
    "coach.crossTraining" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep it light and enjoyable. Different movement patterns help recovery and adaptation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gardez ça léger et agréable. Les mouvements variés aident la récupération et l'adaptation."
          }
        }
      }
    },
    "coach.intervals" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Full recovery between reps matters more than speed. If form breaks down, stop the set."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La récupération complète entre les répétitions compte plus que la vitesse. Si la forme se dégrade, arrêtez la série."
          }
        }
      }
    },
    "coach.longRun.easy" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Focus on time on feet, not pace. Walk uphills if needed. Save your legs for the flats."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Concentrez-vous sur le temps debout, pas l'allure. Marchez en montée si besoin."
          }
        }
      }
    },
    "coach.longRun.hard" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Push the pace on this one but stay controlled. Practice fueling at race effort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poussez l'allure mais restez contrôlé. Pratiquez le ravitaillement à l'effort de course."
          }
        }
      }
    },
    "coach.longRun.moderate" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Steady state run. Lock into a rhythm and practice your race nutrition strategy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sortie régulière. Trouvez votre rythme et pratiquez votre stratégie nutritionnelle de course."
          }
        }
      }
    },
    "coach.recovery" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If in doubt, go slower. This run is about blood flow, not fitness gains."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En cas de doute, ralentissez. Cette sortie sert à la circulation sanguine, pas aux gains de forme."
          }
        }
      }
    },
    "coach.rest" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Active rest: foam roll, walk, stretch. Quality sleep tonight is your biggest performance gain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Repos actif : rouleau, marche, étirements. Un bon sommeil est votre meilleur allié performance."
          }
        }
      }
    },
    "coach.tempo" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Find a rhythm you can hold for the whole session. If you can't finish a sentence, slow down slightly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trouvez un rythme tenable sur toute la séance. Si vous ne pouvez plus parler, ralentissez un peu."
          }
        }
      }
    },
