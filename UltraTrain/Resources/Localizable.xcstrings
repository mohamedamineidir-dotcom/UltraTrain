    "roadLR.desc.mpBlocks" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternating blocks of marathon-pace effort. Lock in race pace %lld times with easy recovery between."
          }
        },
